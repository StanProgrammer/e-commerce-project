# ── env:push credentials ─────────────────────────────────────────────────
# Copy this file to `.env.push` (it is gitignored), fill in the values, and
# run `npm run env:push` to sync Render + Vercel from your local env files.
#
#   npm run env:push          # sync both providers
#   npm run env:push:deploy   # also trigger a Render deploy afterwards
#   npm run env:push:dry      # preview changes without sending anything
#   npm run env:push -- --prune   # also remove remote keys that left the local file

# ── Render (server/.env.production) ──────────────────────────────────────
# API key:  https://dashboard.render.com/account/api-keys
RENDER_API_KEY=
# Service id: from your Render service URL, e.g. https://dashboard.render.com/d/web/srv-abc123
RENDER_SERVICE_ID=srv-xxxxxxx
# Multiple services? Uncomment and use a comma-separated list instead:
# RENDER_SERVICE_IDS=srv-aaaaaaa,srv-bbbbbbb

# ── Vercel (client/.env.production) ───────────────────────────────────────
# Token:  https://vercel.com/account/tokens
VERCEL_TOKEN=
# Project id: Vercel project → Settings → General → Project ID
VERCEL_PROJECT_ID=
